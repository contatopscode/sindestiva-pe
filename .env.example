# =============================================================================
# SINDESTIVA-PE · Variáveis de ambiente (template)
# Copie para `.env` (que está no .gitignore) e preencha os valores reais.
# NUNCA commite o `.env`.
#
# Por serviço (cada plataforma lê só o que precisa):
#   - Vercel (apps/web, apps/pwa)         → vars prefixadas NEXT_PUBLIC_*
#                                           + NEXTAUTH_SECRET/URL
#   - Render (apps/api, services/scraper) → DATABASE_URL, REDIS_URL, NEXTAUTH_SECRET,
#                                           EVOLUTION_*, RESEND_*, FCM_*, SENTRY_*
#   - Docker local (postgres, redis)      → POSTGRES_*, REDIS_*
#
# O `docker compose` (infra/docker-compose.yml) lê só POSTGRES_*, REDIS_*, e
# o `DATABASE_URL` que o backend usa pra conectar.
# =============================================================================

# ---------- Ambiente (todos os serviços) ----------
APP_ENV=development
LOG_LEVEL=info
TZ=America/Recife

# =============================================================================
# DEV LOCAL (Docker compose em infra/docker-compose.yml)
# =============================================================================

# ---------- Postgres (Docker local) ----------
# Porta 5433 no host (Mac do Paulo tem Postgres@18 do Homebrew na 5432).
# Conexão SEMPRE via 127.0.0.1 pra forçar IPv4.
DATABASE_URL=postgresql://sindestiva:sindestiva@127.0.0.1:5433/sindestiva
DATABASE_URL_ASYNC=postgresql+asyncpg://sindestiva:sindestiva@127.0.0.1:5433/sindestiva
POSTGRES_USER=sindestiva
POSTGRES_PASSWORD=sindestiva
POSTGRES_DB=sindestiva
POSTGRES_PORT=5433

# ---------- Redis (Docker local) ----------
# Porta 6380 no host (Mac do Paulo tem Redis do Homebrew na 6379).
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_PORT=6380

# =============================================================================
# PRODUÇÃO (Render — apps/api + services/scraper)
# =============================================================================
# Em produção, o `render.yaml` provisiona:
#   - sindestiva-db (Postgres) — connectionString vira DATABASE_URL
#   - sindestiva-redis (Key Value / Redis) — redisUrl vira REDIS_URL
#
# Render gera `DATABASE_URL` no formato `postgresql://user:pass@host/db`.
# O app converte internamente para `postgresql+asyncpg://` (ver app/core/config.py).
#
# As vars abaixo PRECISAM ser configuradas no painel Render (sensitive, não
# vão no render.yaml): EVOLUTION_API_KEY, RESEND_API_KEY, FCM_*, SENTRY_DSN.

# --- Auth (mesmo secret em Vercel e Render, para JWT assinar/validar) ---
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL pública do frontend (Vercel). Em dev: http://localhost:3010
NEXTAUTH_URL=http://localhost:3010
JWT_EXPIRES_IN=8h

# --- TPA / OTP WhatsApp (Evolution API) ---
# Mesmo padrão do Becker/Córtex/FaceGate (Suporte Gerencial).
EVOLUTION_API_URL=https://evolution-evolution-api.vcli1q.easypanel.host
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sindestiva

# --- OGMO ---
# E-mail formal para onde vão as notificações de remanejamento
OGMO_EMAIL=escalacao@ogmo-pe.com.br
OGMO_WEBHOOK_URL=

# --- Resend (e-mail transacional) ---
# Criar conta em https://resend.com (free tier = 3k/mês)
RESEND_API_KEY=
RESEND_FROM=Lousa Sindestiva <noreply@lousa.pscode.ia.br>

# --- Web Push (Firebase Cloud Messaging) ---
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# --- Scraper ---
SCRAPER_USER_AGENT=SINDESTIVA-Lousa/1.0 (+https://lousa.pscode.ia.br)
SCRAPER_TIMEOUT=30
SCRAPER_INTERVAL=60

# --- Observabilidade ---
SENTRY_DSN=

# =============================================================================
# FRONTEND (Vercel — apps/web + apps/pwa)
# =============================================================================
# Estas vars precisam estar configuradas no painel Vercel de CADA projeto
# (web e pwa são projetos Vercel separados). Recomendação: usar "Environments"
# no Vercel para separar dev / preview / production.

# URL do backend (Render). Exemplo: https://sindestiva-api.onrender.com
NEXT_PUBLIC_API_URL=https://sindestiva-api.onrender.com

# URL pública do próprio projeto (Vercel injeta automaticamente $VERCEL_URL,
# mas para produção fixamos o domínio custom).
NEXT_PUBLIC_APP_URL=https://web.lousa.pscode.ia.br
