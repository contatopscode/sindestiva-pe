# =============================================================================
# SINDESTIVA-PE · Lousa Digital
# Copie para `.env` (que está no .gitignore) e preencha os valores reais.
# NUNCA commite o `.env`.
# =============================================================================

# ---------- Ambiente ----------
APP_ENV=development
LOG_LEVEL=info
TZ=America/Recife

# ---------- Banco de Dados ----------
# Porta 5433 no host (Mac do Paulo tem Postgres@18 do Homebrew na 5432).
# Conexão SEMPRE via 127.0.0.1 pra forçar IPv4.
DATABASE_URL=postgresql://sindestiva:sindestiva@127.0.0.1:5433/sindestiva
DATABASE_URL_ASYNC=postgresql+asyncpg://sindestiva:sindestiva@127.0.0.1:5433/sindestiva
POSTGRES_USER=sindestiva
POSTGRES_PASSWORD=sindestiva
POSTGRES_DB=sindestiva
POSTGRES_PORT=5433

# ---------- Redis ----------
# Porta 6380 no host (Mac do Paulo tem Redis do Homebrew na 6379).
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_PORT=6380

# ---------- Auth (NextAuth v5) ----------
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
JWT_EXPIRES_IN=8h

# ---------- TPA (OTP WhatsApp via Evolution API) ----------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sindestiva

# ---------- OGMO ----------
# E-mail formal para onde vão as notificações de remanejamento
OGMO_EMAIL=escalacao@ogmo-pe.com.br
OGMO_WEBHOOK_URL=

# ---------- E-mail transacional (Resend) ----------
# Criar conta em https://resend.com (free tier = 3k/mês)
RESEND_API_KEY=
RESEND_FROM=Lousa Sindestiva <noreply@lousa.pscode.ia.br>

# ---------- Web Push (Firebase Cloud Messaging) ----------
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ---------- Scraper ----------
SCRAPER_USER_AGENT=SINDESTIVA-Lousa/1.0 (+https://lousa.pscode.ia.br)
SCRAPER_TIMEOUT=30
SCRAPER_INTERVAL=60

# ---------- Observabilidade ----------
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
